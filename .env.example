# =============================================================
# CondoSync - variáveis de ambiente
# Copie para .env (cp .env.example .env) e ajuste os valores.
# NUNCA commite o arquivo .env.
# =============================================================

# Ambiente: development | production
NODE_ENV=development

# URL pública da aplicação (usada em links de e-mail, redirects etc.)
APP_URL=http://localhost:3000

# -------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -------------------------------------------------------------
# Credenciais do container Postgres de desenvolvimento (docker-compose.yml)
POSTGRES_USER=condosync
POSTGRES_PASSWORD=condosync_dev
POSTGRES_DB=condosync
# Porta do Postgres no host (127.0.0.1). Troque para 5433 se já tiver um Postgres local.
DB_PORT=5432

# String de conexão usada pela aplicação e pelos scripts de migration/seed.
# Dentro do Docker Compose o host é "db"; o compose sobrescreve este valor
# para os serviços app/migrate, então aqui vale o acesso a partir do host.
# Produção (Supabase): Project Settings > Database > Connection string (URI).
DATABASE_URL=postgresql://condosync:condosync_dev@localhost:5432/condosync

# SSL na conexão com o banco: false em dev local, true no Supabase/produção
DB_SSL=false

# -------------------------------------------------------------
# Autenticação
# -------------------------------------------------------------
# Segredo para assinar o JWT de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-chars

# -------------------------------------------------------------
# Supabase (opcional em dev; usado em produção para Storage etc.)
# -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave com privilégios totais: use SOMENTE no servidor, nunca no browser
SUPABASE_SERVICE_ROLE_KEY=
